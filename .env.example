# Local environment for docker compose. Copy it to .env before the first run:
#
#   cp .env.example .env
#
# Every value below is a placeholder for local development only. Change the
# passwords if the stack is reachable from other machines. Use only letters,
# digits, "-" and "_" in passwords, because some of them end up inside URLs.

# --- Compose ---------------------------------------------------------------

# "llm" also starts Ollama and downloads OLLAMA_MODEL. With qwen2.5:1.5b it
# adds about 2 GB of RAM while answering and, on amd64, about 9.5 GB of disk
# (a 3.4 GB download for the Ollama image plus 1 GB for the model). Leave it
# empty to run without the language model (the rest needs about 1.2 GB of RAM).
COMPOSE_PROFILES=llm
# Tag of the service images. With "dev" compose builds them from the source.
# Set a tag published by CI (for example sha-1a2b3c4) and run
# "docker compose pull" to use the images from GitHub Container Registry.
IMAGE_TAG=dev

# --- PostgreSQL --------------------------------------------------------------

POSTGRES_PASSWORD=change-me-postgres
# One database and one role per component.
NEXTCLOUD_DB_PASSWORD=change-me-nextcloud-db
WATCHMAN_DB_PASSWORD=change-me-watchman-db
LIBRARIAN_DB_PASSWORD=change-me-librarian-db
OBSERVER_DB_PASSWORD=change-me-observer-db

# --- Redis -------------------------------------------------------------------

REDIS_PASSWORD=change-me-redis

# --- Nextcloud ---------------------------------------------------------------
# Nextcloud's password policy needs at least 10 characters.

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin
# Service account "alexandria" (owns the Library and Quarantine folders).
ALEXANDRIA_SERVICE_PASSWORD=change-me-service
# Account "observer" (reads the members' storage usage).
OBSERVER_ACCOUNT_PASSWORD=change-me-observer
# Demo members: alice, bob and carol (carol is a curator).
DEMO_ALICE_PASSWORD=change-me-alice
DEMO_BOB_PASSWORD=change-me-bob
DEMO_CAROL_PASSWORD=change-me-carol
# Address used in links to Nextcloud files.
PUBLIC_BASE_URL=http://localhost:8080

# --- Internal API ------------------------------------------------------------

# Token watchman sends with observer's internal quota check.
OBSERVER_INTERNAL_TOKEN=change-me-observer-token
# Secret Nextcloud sends with its webhook calls to watchman.
WEBHOOK_SECRET=change-me-webhook-secret

# --- Usage reports -----------------------------------------------------------

# Running cost of the platform in euros a month, which observer's monthly
# report splits among the members.
MONTHLY_COST_EUR=5.40

# --- Library -----------------------------------------------------------------

# Top-level folders of the shared library that accept submissions.
LIBRARY_COLLECTIONS=Manuals,Invoices,Contracts,Medical,School,Taxes

# --- Language model (profile "llm") -----------------------------------------

# Use qwen2.5:0.5b if the machine is short of RAM.
OLLAMA_MODEL=qwen2.5:1.5b
